# Copie para .env.evolution-go e ajuste antes de subir:
# cp .env.evolution-go.example .env.evolution-go
# Senha do Postgres dedicado ao Evolution GO
EVOGO_POSTGRES_USER=postgres
EVOGO_POSTGRES_PASSWORD=troque_senha_forte_aqui

# Chave global da API (mesmo valor em EVOLUTION_API_KEY no .env do AppVS)
EVOGO_GLOBAL_API_KEY=troque_chave_global_forte_aqui

# Porta HTTP só em 127.0.0.1 na VPS (admin/curl local)
EVOGO_HTTP_PORT=8085

# Painel público (NPM): https://whatsapp.vivasaude.cloud/manager/login

# Opcional
EVOGO_DATABASE_SAVE_MESSAGES=false
EVOGO_WADEBUG=INFO
EVOGO_CONNECT_ON_STARTUP=true

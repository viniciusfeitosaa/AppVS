  fotoUrl       String?                   @map("foto_url") @db.VarChar(500)
  crm           String?                   @db.VarChar(60)
  especialidade String?                   @db.VarChar(120)
  medicoId      String?                   @map("medico_id")
  status        ConteudoPalestranteStatus @default(PENDENTE_FORM)
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medico  Medico?          @relation(fields: [medicoId], references: [id], onDelete: SetNull)
  eventos ConteudoEvento[]

  @@index([tenantId, nome])
  @@index([tenantId, email])
  @@index([medicoId])
  @@map("conteudo_palestrantes")
}

model ConteudoEvento {
  id                 String               @id @default(uuid())
  tenantId           String               @map("tenant_id")
  titulo             String               @db.VarChar(255)
  capaUrl            String?              @map("capa_url") @db.VarChar(500)
  youtubeUrl         String?              @map("youtube_url") @db.VarChar(500)
  youtubeVideoId     String?              @map("youtube_video_id") @db.VarChar(32)
  descricao          String?              @db.Text
  iniciaEm           DateTime             @map("inicia_em")
  status             ConteudoEventoStatus @default(RASCUNHO)
  palestranteId      String?              @map("palestrante_id")
  tokenPalestrante   String               @unique @map("token_palestrante") @db.VarChar(64)
  tokenInscricao     String               @unique @map("token_inscricao") @db.VarChar(64)
  tokenFrequencia    String               @unique @map("token_frequencia") @db.VarChar(64)
  frequenciaAberta   Boolean              @default(false) @map("frequencia_aberta")
  frequenciaAbertaEm DateTime?            @map("frequencia_aberta_em")
  frequenciaFechadaEm DateTime?           @map("frequencia_fechada_em")
  /// Exige preenchimento da avaliação de aula ao confirmar presença.
  avaliacaoAtiva     Boolean              @default(false) @map("avaliacao_ativa")
  /// JSON: { titulo, meta, perguntas[] } — ver conteudo-avaliacao.const.ts
  avaliacaoFormulario Json?               @map("avaliacao_formulario")
  criadoPorMasterId  String?              @map("criado_por_master_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  palestrante     ConteudoPalestrante?   @relation(fields: [palestranteId], references: [id], onDelete: SetNull)
  criadoPorMaster UsuarioMaster?         @relation("conteudo_evento_criador", fields: [criadoPorMasterId], references: [id], onDelete: SetNull)
  participantes   ConteudoParticipante[]

  @@index([tenantId, status, iniciaEm])
  @@index([palestranteId])
  @@map("conteudo_eventos")
}

model ConteudoParticipante {
  id                     String                     @id @default(uuid())
  tenantId               String                     @map("tenant_id")
  eventoId               String                     @map("evento_id")
  origem                 ConteudoParticipanteOrigem
  /// Perfil do inscrito externo (ou médico do app).
  perfil                 ConteudoParticipantePerfil @default(MEDICO)
  medicoId               String?                    @map("medico_id")
  nome                   String                     @db.VarChar(255)
  email                  String                     @db.VarChar(255)
  telefone               String?                    @db.VarChar(30)
  cpf                    String?                    @db.VarChar(14)
  crm                    String?                    @db.VarChar(60)
  especialidade          String?                    @db.VarChar(120)
  cidade                 String?                    @db.VarChar(120)
  faculdade              String?                    @db.VarChar(255)
  semestre               String?                    @db.VarChar(40)
  participaLiga          Boolean?                   @map("participa_liga")
  ligaNome               String?                    @map("liga_nome") @db.VarChar(255)
  /// Precadastro para possível ingresso no corpo clínico.
  interesseCorpoClinico  Boolean                    @default(true) @map("interesse_corpo_clinico")
  consentimentoLgpd      Boolean                    @default(false) @map("consentimento_lgpd")
  /// Fluxo aceite → e-mail → cadastro ATIVO (não passa por Avaliação).
  precadastroStatus      ConteudoPrecadastroStatus  @default(AGUARDANDO) @map("precadastro_status")
  tokenCadastroCorpo     String?                    @unique @map("token_cadastro_corpo") @db.VarChar(64)
  precadastroAceitoEm    DateTime?                  @map("precadastro_aceito_em")
  precadastroAceitoPorMasterId String?              @map("precadastro_aceito_por_master_id")
  presenteEm             DateTime?                  @map("presente_em")
  presencaOrigem         ConteudoPresencaOrigem?    @map("presenca_origem")
  /// Respostas da avaliação de aula (mapa perguntaId → valor).
  avaliacaoRespostas     Json?                      @map("avaliacao_respostas")
  avaliadoEm             DateTime?                  @map("avaliado_em")
  createdAt              DateTime                   @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evento ConteudoEvento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  medico Medico?        @relation(fields: [medicoId], references: [id], onDelete: SetNull)

  @@unique([eventoId, email])
  @@unique([eventoId, medicoId])
  @@index([tenantId, eventoId])
  @@index([tenantId, origem, createdAt])
  @@index([tenantId, precadastroStatus])
  @@index([medicoId])
  @@map("conteudo_participantes")
}

/// Contador atômico para numeração automática de documentos DocuSeal (ex.: termo de transferência).
model DocusealDocumentoContador {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  /// Ex.: termo_transferencia
  chave        String   @db.VarChar(80)
  /// Ano civil (São Paulo) da sequência.
  ano          Int
  /// Último número sequencial emitido neste ano.
  ultimoNumero Int      @default(0) @map("ultimo_numero")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chave, ano])
  @@index([tenantId])
  @@map("docuseal_documento_contadores")
}

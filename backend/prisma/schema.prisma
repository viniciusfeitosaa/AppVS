  decididoPor   UsuarioMaster?  @relation("justificativa_ausencia_decidido_por", fields: [decididoPorMasterId], references: [id], onDelete: SetNull)
  registroPonto RegistroPonto?  @relation(fields: [registroPontoId], references: [id], onDelete: SetNull)

  @@map("justificativas_ausencia_ponto")
  @@index([tenantId, status])
  @@index([tenantId, medicoId])
  @@index([escalaPlantaoId])
  @@unique([registroPontoId])
}

// Registro de pedido: PERMUTA (troca bilateral) ou CEDER (cede o plantão ao aceitante, sem contrapartida).
// medicoDestinoId e contrapartidaPlantaoId nulos = pedido aberto à equipe.
model SolicitacaoTrocaPlantao {
  id                       String   @id @default(uuid())
  tenantId                 String   @map("tenant_id")
  escalaPlantaoId          String   @map("escala_plantao_id")
  /// Plantão do colega que o solicitante assume em troca (mesma escala). Só em PERMUTA.
  contrapartidaPlantaoId   String?  @map("contrapartida_plantao_id")
  medicoSolicitanteId      String   @map("medico_solicitante_id")
  /// Null = aberto a colegas da mesma equipe na escala; preenchido ao aceitar ou em pedido direto.
  medicoDestinoId          String?  @map("medico_destino_id")
  /// PERMUTA | CEDER
  tipoSolicitacao          String   @default("PERMUTA") @map("tipo_solicitacao") @db.VarChar(20)
  status                   String   @default("PENDENTE") @db.VarChar(20)
  respondidaEm             DateTime? @map("respondida_em")
  createdAt                DateTime @default(now()) @map("created_at")

  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plantao              EscalaPlantao  @relation("TrocaPlantaoPrincipal", fields: [escalaPlantaoId], references: [id], onDelete: Cascade)
  plantaoContrapartida EscalaPlantao? @relation("TrocaPlantaoContrapartida", fields: [contrapartidaPlantaoId], references: [id], onDelete: Cascade)
  solicitante          Medico         @relation("SolicitacaoTrocaSolicitante", fields: [medicoSolicitanteId], references: [id], onDelete: Cascade)
  destino              Medico?        @relation("SolicitacaoTrocaDestino", fields: [medicoDestinoId], references: [id], onDelete: Cascade)

  @@map("solicitacoes_troca_plantao")
  @@index([tenantId, medicoSolicitanteId])
  @@index([tenantId, medicoDestinoId, status])
  @@index([escalaPlantaoId])
  @@index([contrapartidaPlantaoId])
}

model TipoPlantao {
  id               String   @id @default(uuid())
